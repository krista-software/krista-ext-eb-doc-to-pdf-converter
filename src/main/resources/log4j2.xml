<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="error">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%-5p %c{1}:%L - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Root at INFO to suppress noisy third-party debug logs -->
        <Root level="info">
            <AppenderRef ref="console"/>
        </Root>

        <!-- Our extension package at DEBUG -->
        <Logger name="app.krista.extensions.ebplayground.ebtesting.ebdoctopdfconverter" level="debug" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="app.krista" level="debug" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>

        <!-- Suppress noisy third-party libraries -->
        <Logger name="org.apache.poi" level="warn"/>
        <Logger name="org.apache.pdfbox" level="warn"/>
        <Logger name="org.apache.fontbox" level="warn"/>
    </Loggers>
</Configuration>
